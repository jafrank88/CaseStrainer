<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<OfficeApp
    xmlns="http://schemas.microsoft.com/office/appforoffice/1.1"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:bt="http://schemas.microsoft.com/office/officeappbasictypes/1.0"
    xsi:type="TaskPaneApp">

    <Id>7a4f8c2e-1b9d-4e3a-8f6c-2d5e9a1b3c7d</Id>
    <Version>1.1.0.0</Version>
    <ProviderName>CaseStrainer</ProviderName>
    <DefaultLocale>en-US</DefaultLocale>
    <DisplayName DefaultValue="CaseStrainer" />
    <Description DefaultValue="Validate legal citations using the CaseStrainer API (same backend as the web app)." />
    <IconUrl DefaultValue="https://wolf.law.uw.edu/casestrainer/word-addin/icons/icon-32.png" />
    <HighResolutionIconUrl DefaultValue="https://wolf.law.uw.edu/casestrainer/word-addin/icons/icon-64.png" />
    <SupportUrl DefaultValue="https://github.com/jafrank88/casestrainer" />

    <AppDomains>
        <AppDomain>https://wolf.law.uw.edu</AppDomain>
    </AppDomains>

    <Hosts>
        <Host Name="Document" />
    </Hosts>
    <DefaultSettings>
        <SourceLocation DefaultValue="https://wolf.law.uw.edu/casestrainer/word-addin/index.html" />
    </DefaultSettings>

    <Permissions>ReadWriteDocument</Permissions>

    <VersionOverrides xmlns="http://schemas.microsoft.com/office/taskpaneappversionoverrides" xsi:type="VersionOverridesV1_0">
        <Hosts>
            <Host xsi:type="Document">
                <DesktopFormFactor>
                    <FunctionFile resid="Commands.Url" />
                    <ExtensionPoint xsi:type="PrimaryCommandSurface">
                        <OfficeTab id="TabHome">
                            <Group id="CaseStrainerGroup">
                                <Label resid="GroupLabel" />
                                <Icon>
                                    <bt:Image size="16" resid="Icon16" />
                                    <bt:Image size="32" resid="Icon32" />
                                    <bt:Image size="80" resid="Icon80" />
                                </Icon>
                                <Control xsi:type="Button" id="CaseStrainerPane">
                                    <Label resid="ButtonLabel" />
                                    <Supertip>
                                        <Title resid="ButtonLabel" />
                                        <Description resid="ButtonTip" />
                                    </Supertip>
                                    <Icon>
                                        <bt:Image size="16" resid="Icon16" />
                                        <bt:Image size="32" resid="Icon32" />
                                        <bt:Image size="80" resid="Icon80" />
                                    </Icon>
                                    <Action xsi:type="ShowTaskpane">
                                        <TaskpaneId>CaseStrainerTaskpane</TaskpaneId>
                                        <SourceLocation resid="Taskpane.Url" />
                                    </Action>
                                </Control>
                            </Group>
                        </OfficeTab>
                    </ExtensionPoint>
                </DesktopFormFactor>
            </Host>
        </Hosts>
        <Resources>
            <bt:Images>
                <bt:Image id="Icon16" DefaultValue="https://wolf.law.uw.edu/casestrainer/word-addin/icons/icon-16.png" />
                <bt:Image id="Icon32" DefaultValue="https://wolf.law.uw.edu/casestrainer/word-addin/icons/icon-32.png" />
                <bt:Image id="Icon80" DefaultValue="https://wolf.law.uw.edu/casestrainer/word-addin/icons/icon-80.png" />
            </bt:Images>
            <bt:Urls>
                <bt:Url id="Commands.Url" DefaultValue="https://wolf.law.uw.edu/casestrainer/word-addin/commands.html" />
                <bt:Url id="Taskpane.Url" DefaultValue="https://wolf.law.uw.edu/casestrainer/word-addin/index.html" />
            </bt:Urls>
            <bt:ShortStrings>
                <bt:String id="GroupLabel" DefaultValue="CaseStrainer" />
                <bt:String id="ButtonLabel" DefaultValue="Citations" />
            </bt:ShortStrings>
            <bt:LongStrings>
                <bt:String id="ButtonTip" DefaultValue="Open CaseStrainer to validate citations in this document." />
            </bt:LongStrings>
        </Resources>
    </VersionOverrides>
</OfficeApp>
