# .env.example

# === API KEYS ===
# CourtListener API Key (required for citation verification)
COURTLISTENER_API_KEY=your_courtlistener_api_key_here

# LangSearch API Key (required for LangSearch integration)
LANGSEARCH_API_KEY=your_langsearch_api_key_here

# (Optional) Master key for encryption/decryption, if used
# MASTER_KEY=your_master_key_here

# === REDIS / TASK QUEUE ===
# Redis password (required — generate with: python -c "import secrets; print(secrets.token_urlsafe(32))")
REDIS_PASSWORD=your_redis_password_here
# Redis URL for async task queue (RQ)
REDIS_URL=redis://:${REDIS_PASSWORD}@casestrainer-redis-prod:6379/0

# Async task result/progress TTL in Redis (seconds). Default 3600 = 1 hour. Clamped 60–604800.
# DATA_RETENTION_ASYNC_SECONDS=3600

# Delete uploaded file on worker after async file job completes (success or failure). Default true.
# UPLOAD_DELETE_AFTER_PROCESSING=true

# Log full JSON API responses under /app/logs (privacy risk). Default false.
# CASESTRAINER_LOG_FULL_API_RESPONSES=false

# === FLASK / APP CONFIG ===
# Flask environment: 'production' or 'development'
FLASK_ENV=production

# Comma-separated allowed CORS origins. Default also allows regex
# chrome-extension://* and moz-extension://* when CORS_ALLOW_BROWSER_EXTENSIONS=true.
# CORS_ORIGINS=https://wolf.law.uw.edu,http://localhost:5173
# CORS_ALLOW_BROWSER_EXTENSIONS=true

# Flask secret key (required for session security — generate with: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=your_flask_secret_key_here

# Sentry DSN for error monitoring (optional but strongly recommended in production)
# Get your DSN from https://sentry.io → Project Settings → Client Keys
# Leave blank to disable Sentry error reporting.
SENTRY_DSN=

# === LOGGING ===
# Log file path (optional, if you want to override default)
# LOG_FILE=logs/casestrainer_production.log

# === DATABASE ===
# (Optional) Database URL if using a database other than SQLite
# DATABASE_URL=sqlite:///data/citations.db

# === OTHER CONFIG ===
# (Add any other environment variables your app uses here)

# === VERIFICATION CONFIG ===
# Enable verification registry (includes backup search for recent cases)
VERIFY_USE_REGISTRY=true
# Verification and citation-metadata cache: set to true to use caches across documents.
# When false (default): verification cache and citation-metadata cache are both disabled;
# each document is verified against live sources and name/year are extracted from the current document only.
VERIFICATION_CACHE_ENABLED=false