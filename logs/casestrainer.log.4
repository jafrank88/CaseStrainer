  "slug": "marbury-v-madison",
  "case_name_short": "Marbury",
  "case_name": "Marbury v. Madison",
  "case_name_full": "WILLIAM MARBURY v. JAMES MADISON, Secretary of State of the United States",
  "scdb_id": "1803-005",
  "scdb_decision_direction": 1,
  "scdb_votes_majority": 6,
  "scdb_votes_minority": 0,
  "source": "LRU",
  "procedural_history": "",
  "attorneys": "Mr. Lee, in support of the rule,, Mr. Daniel Brent testified, Mr. Lincoln, attorney general,, Mr. Lee, in reply,, Mr. Lee replied,",
  "nature_of_suit": "",
