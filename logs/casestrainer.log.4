2025-06-27 17:33:46,148 | INFO | src.enhanced_multi_source_verifier | [CourtListener] Raw result for '5 U.S. 137': {
  "resource_uri": "https://www.courtlistener.com/api/rest/v4/clusters/84759/",
  "id": 84759,
  "absolute_url": "/opinion/84759/marbury-v-madison/",
  "panel": [],
  "non_participating_judges": [],
  "docket_id": 198164,
  "docket": "https://www.courtlistener.com/api/rest/v4/dockets/198164/",
  "sub_opinions": [
    "https://www.courtlistener.com/api/rest/v4/opinions/84759/"
  ],
  "citations": [
    {
      "volume": 5,
      "reporter": "U.S.",
