  "slug": "hermance-v-board-of-supervisors",
  "case_name_short": "Matter of Hermance",
  "case_name": "Hermance v. Board of Supervisors",
  "case_name_full": "In the Matter of the Application of Henry L. Hermance Et Al., Appellants, v. the Board of Supervisors of Ulster County, Respondent",
