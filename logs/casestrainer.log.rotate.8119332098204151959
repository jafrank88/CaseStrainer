  "case_name": "Milwaukie & Minnesota Railroad v. Soutter",
  "case_name_full": "Milwaukie and Minnesota Railroad Company and Fleming, Appellants, v. Soutter, Survivor",
  "scdb_id": "1864-055",
  "scdb_decision_direction": 2,
  "scdb_votes_majority": 8,
