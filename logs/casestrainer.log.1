ion_count': 19, 'precedential_status': 'Published', 'date_blocked': None, 'blocked': False, 'filepath_json_harvard': 'law.free.cap.wash-2d.83/898.1127864.json', 'filepath_pdf_harvard': 'harvard_pdf/1184293.pdf', 'arguments': '', 'headmatter': '<docketnumber id="b930-10">\n    [No. 42255.\n   </docketnumber><court id="AFS">\n    En Banc.\n   </court><decisiondate id="A1be">\n    June 20, 1974.]\n   </decisiondate><br><parties id="b930-11">\n    Jim House,\n    <em>\n     Petitioner\n    </em>\n    v. Harold Erwin\n    <em>\n     et al., Respondents.\n    </em>\n</parties><br><attorneys id="b931-9">\n<span citation-index="1" class="star-pagination" label="899"> \n     *899\n     </span>\n<em>\n     Kelly Hancock,\n    </em>\n    for petitioner.\n   </attorneys><br><attorneys id="b931-10">\n<em>\n     John Hancock,\n    </em>\n    for respondents.\n   </attorneys>'}]}], 'explanation': 'Citation found in CourtListener database', 'status': None, 'error_message': None, 'sources_checked': ['CourtListener Citation Lookup API'], 'case_name_extracted': None, 'case_name_verified': 'House v. Erwin', 'name_similarity': 0.0, 'highlight': True}
