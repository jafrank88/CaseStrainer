# CaseStrainer .gitignore - Optimized for Vue.js migration
# Last updated: 2025-11-06
# --- Security: Prevent accidental commits of secrets and certificates ---
# SSL/TLS certificates and keys (globally ignored)
*.pem
*.crt
*.key
*.cert
*.csr
*.pfx
*.p12
# SSL directories (all locations)
ssl/
docker/ssl/
nginx/ssl/
nginx-1.24.0/ssl/
# -------------------------------------------------------------------------------
#----------------------------------------------
# DIRECTORIES TO EXCLUDE
# Development and runtime directories
archive/
archive_temp_files/
archive_2025_01_20/
__pycache__/
.cache/
citation_cache/
correction_cache/
casestrainer_sessions/
flask_session/
instance/
temp_uploads/
uploads/
wa_briefs/
wa_briefs_text/
downloaded_briefs/
sample_briefs/
reports/
word_addin/
backup_before_update/
# Python build directories
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
# Environment directories
.venv/
env/
venv/
ENV/
# IDE directories
.idea/
.vscode/*
!.vscode/settings.json
# Test directories - with specific exceptions
tests/
test/
testing/
spec/
specs/
fixtures/
mocks/
stubs/
typings/
types/
!tests/test_courtlistener_api.py
!tests/test_api.py
!tests/test_enhanced_validator.py
!tests/test_citation_verification.py
# Large external libraries
python-hyperscan/
hyperscan/
vcpkg/
models/
learning_data/
# Vue.js specific
node_modules/
*.tsbuildinfo
casestrainer-vue-backup/
frontend/
temp-vue*/
temp-vue-app/
temp-vue-fix/
temp-serve/
# FILES TO EXCLUDE
# Database exports and Excel files (private data)
*.xlsx
*.xls
casestrainer_database_export_*.xlsx
database_export_*.xlsx
# Log files - ALL (CRITICAL: Prevents 94MB file push failures)
logs/
*.log
!logs/.gitkeep
w*.txt
*_w*.txt
realtime*.txt
fresh_logs*.txt
full_w*.txt
# Test result files (NOT test code)
test_*.json
*_results.json
*_analysis.json
*_citations.json
*_clusters.json
production_*.json
last_test_citations.json
# Test data files
test_*.txt
*_test.txt
comprehensive_test.txt
comprehensive_test_citations.txt
test_citations_fixed.txt
specific_gaps_test.txt
courtlistener_gaps_test.txt
extracted_pdf_text.txt
extracted_text.txt
avianca_extracted_text.txt
*_debug.txt
*_context.txt
surrounding_debug.txt
extraction_analysis*.txt
fallback_extended_context*.txt
# Debug and temporary Python scripts
debug_*.py
test_extraction*.py
test_direct*.py
test_simple*.py
quick_test*.py
temp_*.py
fix_*.py
analyze_*.py
!analyze_imports.py
!analyze_cluster_context.py
# Large PDF files (keep only essential docs)
*.pdf
!docs/*.pdf
!documentation/*.pdf
# Python cache files
*.py[cod]
*$py.class
*.so
*.pyc
*.pyo
*.pyd
# Database files - with exceptions
*.db
!example_citations.db
# Backup files
*.bak
*.backup
# Environment and IDE files
.env
.env.*
!.env.example
*.swp
*.swo
*.sublime-workspace
*.sublime-project
# Temporary files
*.tmp
*.temp
*~
.Python
# System files
.DS_Store
Thumbs.db
# EXCEPTIONS - FILES TO INCLUDE
# Documentation
!README.md
!DEPLOYMENT.md
!DEPLOYMENT_VUE.md
!BATCH_FILES.md
!API_SETUP.md
# Allow CSV output files
!*courtlistener_citations*.csv
!*processing_summary*.json
!*.csv
# Configuration files
!requirements.txt
!requirements-test.txt
!config.json
!package.json
!package-lock.json
!tsconfig.json
!vite.config.js
!vite.config.ts
!nginx.conf
!nginx-*.conf
!docker-compose.yml
!Dockerfile
# Essential scripts
!scripts/*.bat
!scripts/*.ps1
!start_*.bat
!restart_*.bat
!commit_push_and_deploy.bat
!deploy_*.bat
!launch*.bat
!launch*.ps1
!casestrainer-vue-new/src/
!casestrainer-vue-new/public/
!casestrainer-vue-new/index.html
!casestrainer-vue-new/package.json
!casestrainer-vue-new/vite.config.js
!casestrainer-vue-new/tsconfig.json
# Test files that should be tracked
!tests/conftest.py
!tests/test_*.py
!src/test_*.py
# Allow specific log files for debugging
!logs/app_startup_*.log
!logs/casestrainer_*.log
